---
interface PreviousRole {
  role: string;
  company: string;
  logo?: string;
  description: string;
}

interface Props {
  role: string;
  company: string;
  logo?: string;
  description: string;
  previousRoles?: PreviousRole[];
}

const { role, company, logo, description, previousRoles } = Astro.props;
---

<section class="section">
  <h2 class="section-title">
    <span class="section-number">01.</span> Current Role
  </h2>

  <div class="mb-2">
    <div class="flex items-center gap-3 mb-1">
      {logo && (
        <img src={logo} alt={company} class="h-6 w-auto object-contain mix-blend-multiply dark:mix-blend-normal dark:bg-white dark:rounded dark:px-1" />
      )}
      <h3 class="text-[0.9375rem] font-semibold text-accent">{role}</h3>
    </div>
    <p class="text-[0.9375rem] text-accent mb-3">{company}</p>
  </div>

  <p class="text-[0.9375rem] text-text-secondary leading-relaxed">{description}</p>
</section>

{previousRoles && previousRoles.length > 0 && (
  <section class="section">
    <h2 class="section-title">Previous Roles</h2>
    <div class="space-y-8">
      {previousRoles.map((prev) => (
        <div>
          <div class="flex items-center gap-3 mb-1">
            {prev.logo && (
              <img src={prev.logo} alt={prev.company} class="h-6 w-auto object-contain mix-blend-multiply dark:mix-blend-normal dark:bg-white dark:rounded dark:px-1" />
            )}
            <h3 class="text-[0.9375rem] font-semibold text-accent">{prev.role}</h3>
          </div>
          <p class="text-[0.9375rem] text-accent mb-3">{prev.company}</p>
          <p class="text-[0.9375rem] text-text-secondary leading-relaxed">{prev.description}</p>
        </div>
      ))}
    </div>
  </section>
)}
