---
import TechIcon from './TechIcon.astro';

interface Tech {
  name?: string;
  icon: string;
}

interface Props {
  techStack: Tech[];
}

const { techStack } = Astro.props;
---

<section class="section">
  <h2 class="section-title">
    <span class="section-number">02.</span> Technical Stack
  </h2>

  <div class="flex flex-wrap gap-5">
    {techStack.map((tech) => (
      <TechIcon icon={tech.icon} name={tech.name ?? ''} loading="lazy" />
    ))}
  </div>
</section>
