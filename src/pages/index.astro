---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Role from '../components/Role.astro';
import TechStack from '../components/TechStack.astro';
import Projects from '../components/Projects.astro';
import Social from '../components/Social.astro';

// Types
interface Tech {
  name: string;
  icon: string;
}

interface Project {
  name: string;
  description?: string;
  githubUrl: string;
  technologies: Tech[];
}

// Personal Information
const PERSONAL_INFO = {
  name: 'Eben Bentley',
  displayName: 'EBEN BENTLEY',
  title: 'Software Engineer',
  company: 'Zaizi',
  bio: 'Software engineer working on cybersecurity-focused systems where quality, security and reliability actually matter. I specialise in backend engineering and cloud infrastructure, delivering software that is built to last and built to perform.',
  roleDescription: 'Backend services and cloud infrastructure, working primarily in Go and Java on AWS with a focus on infrastructure as code.',
} as const;

// Previous Roles
const previousRoles = [
  {
    role: 'Software Engineer',
    company: 'Raytheon UK',
    logo: '/icons/raytheon.png',
    description: 'Full-stack systems and cloud infrastructure across AWS and Azure.',
  },
];

// Tech Stack
const techStack: Tech[] = [
  // Languages
  { name: 'Go', icon: '/icons/go.svg' },
  { name: 'Java', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg' },
  { name: 'Python', icon: '/icons/python.svg' },
  { name: 'TypeScript', icon: '/icons/typescript.png' },

  // Runtimes / Frameworks
  { name: 'NodeJs', icon: '/icons/nodejs.png' },

  // APIs & Communication
  { name: 'REST APIs', icon: '/icons/rest-api.svg' },

  // Frontend
  { name: 'React', icon: '/icons/react.png' },
  { name: 'Next.js', icon: '/icons/next.png' },

  // Databases
  { name: 'PostgreSQL', icon: '/icons/postgresql.svg' },
  { name: 'MySQL', icon: '/icons/mysql.svg' },

  // Messaging & Async
  { name: 'RabbitMQ', icon: '/icons/rabbitmq.svg' },

  // Containers & Orchestration
  { name: 'Docker', icon: '/icons/docker.svg' },
  { name: 'Kubernetes', icon: '/icons/kubernetes.svg' },
  { name: 'Red Hat', icon: '/icons/redhat.png' },

  // Cloud Providers
  { name: 'AWS', icon: '/icons/aws.svg' },
  { name: 'Azure', icon: '/icons/azure.png' },

  // Data / Search
  { name: 'ElasticSearch', icon: '/icons/elasticsearch.png' },
  { name: 'OpenSearch', icon: '/icons/opensearch.png' },
  { name: 'Azure Data Factory', icon: '/icons/azure-data-factory.png' },

  // Infrastructure as Code
  { name: 'Terraform', icon: '/icons/terraform.svg' },
  { name: 'Ansible', icon: '/icons/ansible.svg' },
];

// Projects
const projects: Project[] = [
  {
    name: 'Portfolio Website',
    description: 'Modern portfolio website built with Astro and TailwindCSS. Features responsive design, dark mode support, and optimized performance with static site generation.',
    githubUrl: 'https://github.com/Eben-Bentley/Personal-Blog',
    technologies: [
      { name: 'Astro', icon: 'https://img.icons8.com/?size=64&id=lckHFUP7nJhG&format=png' },
      { name: 'TailwindCSS', icon: 'https://icon.icepanel.io/Technology/svg/Tailwind-CSS.svg' }
    ],
  }
];
---

<Layout
  title={`${PERSONAL_INFO.name} - ${PERSONAL_INFO.title}`}
  name={PERSONAL_INFO.name}
  description="Software Engineer at Zazi. Experienced in Go, Java, AWS, and infrastructure as code. View projects and skills."
>
<div class="container max-w-4xl mx-auto space-y-16">

    <Hero
      name={PERSONAL_INFO.displayName}
      title={PERSONAL_INFO.title}
      bio={PERSONAL_INFO.bio}
    />

    <Role
      role={PERSONAL_INFO.title}
      company={PERSONAL_INFO.company}
      logo="/icons/zaizi.jpg"
      description={PERSONAL_INFO.roleDescription}
      previousRoles={previousRoles}
    />

    <TechStack techStack={techStack} />

    <Projects projects={projects} />

    <Social />

  </div>
</Layout>
